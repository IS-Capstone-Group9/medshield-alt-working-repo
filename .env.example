PORT=5000
FLASK_DEBUG=1
USE_SUPABASE=true

NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
SUPABASE_PROJECT_ID=ghrpgyzbjmhgoduxzdyp

SUPABASE_URL=https://ghrpgyzbjmhgoduxzdyp.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
# Server only. Prefer the modern sb_secret_ key; never use NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=replace-with-your-server-secret
# Legacy alternative when a modern secret key is not available.
SUPABASE_SERVICE_ROLE_KEY=
ANALYTICS_SERVICE_URL=http://localhost:5101
PRODUCT_SERVICE_URL=http://localhost:5102

# Databricks server-side analytics connection.
# Copy these values into backend/.env. Never expose them through NEXT_PUBLIC_*.
DATABRICKS_HOST=https://replace-with-your-workspace-host
DATABRICKS_TOKEN=replace-with-your-sql-scoped-token
DATABRICKS_SQL_WAREHOUSE_ID=replace-with-your-warehouse-id
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=medshield_gold
