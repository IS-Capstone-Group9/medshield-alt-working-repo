PORT=5000
FLASK_DEBUG=1
USE_SUPABASE=true

NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
SUPABASE_PROJECT_ID=ghrpgyzbjmhgoduxzdyp

SUPABASE_URL=https://ghrpgyzbjmhgoduxzdyp.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
# Server only. Prefer the modern sb_secret_ key; never use NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=replace-with-your-server-secret
# Legacy alternative when a modern secret key is not available.
SUPABASE_SERVICE_ROLE_KEY=
# Databricks server-side analytics connection.
# Copy these values into backend/.env. Never expose them through NEXT_PUBLIC_*.
DATABRICKS_HOST=https://replace-with-your-workspace-host
DATABRICKS_TOKEN=replace-with-your-sql-scoped-token
DATABRICKS_SQL_WAREHOUSE_ID=replace-with-your-warehouse-id
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=medshield_gold
# Pin the candidate validated in docs/CURRENT_STATE.md; restart the gateway after changing it.
DATABRICKS_DESCRIPTIVE_FACT_VERSION=0
# Stored research keeps its own original fact pin, independent of the descriptive source.
DATABRICKS_RESEARCH_FACT_VERSION=20

# Verified original catalog profile: four bounded 2,000-row page readers.
# Gateway-only; measure under the target warehouse/load before release.
DATABRICKS_QUERY_CONCURRENCY=6
# Selects the current original itemized Gold source (see docs/SETUP.md).
# Blank falls back to the superseded legacy pins, so keep this set unless restoring them.
DATABRICKS_DESCRIPTIVE_ADAPTER=original_itemized_v1
# Supply the approved frontend origin(s) in a hosted gateway environment.
CORS_ALLOWED_ORIGINS=
# Optional validated analytical selectors; forwarding does not grant publication.
DATABRICKS_FINANCIAL_RELEASE_ID=
DATABRICKS_FINANCIAL_MANIFEST_SHA256=
DATABRICKS_EXTENSION_RESEARCH_SHA256=
DATABRICKS_SO1_SHA256=
DATABRICKS_TRUTH_RELEASE_ID=
DATABRICKS_TRUTH_MANIFEST_SHA256=
DATABRICKS_TRUTH_STL_SHA256=

# Controlled CSV intake (server-only; never NEXT_PUBLIC_). Leave disabled until the Databricks volume, job and
# permissions are provisioned; see docs/CONTROLLED_SALES_INTAKE.md.
DATABRICKS_INGESTION_ENABLED=false
DATABRICKS_INGESTION_CLIENT_EXPORTS=false
DATABRICKS_INGESTION_VOLUME=/Volumes/replace_catalog/replace_schema/replace_volume
DATABRICKS_INGESTION_JOB_ID=
DATABRICKS_INGESTION_TOKEN=
# Dashboard fact source: gold (default) or warehouse (exact copies stored with a warehouse release; decision 014).
DATABRICKS_ITEMIZED_SOURCE=gold
DATABRICKS_WAREHOUSE_RELEASE_ID=
