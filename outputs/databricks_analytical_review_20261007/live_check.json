    "latest_fact_history": "DESCRIBE HISTORY workspace.medshield_gold.sales_restart_fact_candidate LIMIT 1",
    "latest_fact_identity": "SELECT DISTINCT dataset_id, policy_version, resolution_policy, area_mapping_sha256, product_master_sha256, transaction_evidence_sha256, catalog_helper_sha256, publication_status FROM workspace.medshield_gold.sales_restart_fact_candidate VERSION AS OF 17",
    "latest_fact_totals": "SELECT COUNT(*) AS records, COUNT(DISTINCT source_record_id) AS unique_records, COUNT(DISTINCT canonical_group_id) AS product_groups,\n      SUM(CASE WHEN identity_status='approved' THEN 1 ELSE 0 END) AS approved_identity_records,\n      SUM(CASE WHEN category_status='approved' THEN 1 ELSE 0 END) AS approved_category_records,\n      SUM(CASE WHEN is_adjusted_source THEN 1 ELSE 0 END) AS adjusted_records,\n      SUM(CASE WHEN is_net_sales_eligible THEN net_sales END) AS eligible_net_sales,\n      COUNT(DISTINCT CASE WHEN is_net_sales_eligible THEN month_start END) AS observed_revenue_months\n      FROM workspace.medshield_gold.sales_restart_fact_candidate VERSION AS OF 17",
    "yearly_quality": "SELECT calendar_year, COUNT(*) AS records,\n      SUM(CASE WHEN is_net_sales_eligible THEN net_sales END) AS eligible_net_sales,\n      COUNT(DISTINCT CASE WHEN is_net_sales_eligible THEN month_start END) AS observed_revenue_months,\n      SUM(CASE WHEN is_adjusted_source THEN 1 ELSE 0 END) AS adjusted_records,\n      SUM(CASE WHEN is_gross_margin_eligible THEN net_sales END) AS margin_eligible_revenue,\n      SUM(CASE WHEN is_gross_margin_eligible THEN gross_margin_amount END) AS eligible_gross_margin\n      FROM workspace.medshield_gold.sales_restart_fact_candidate VERSION AS OF 17 GROUP BY calendar_year ORDER BY calendar_year",
    "stl_identity": "SELECT fact_delta_version,dataset_id,policy_version,COUNT(*) AS rows FROM workspace.medshield_gold.sales_restart_stl_candidate GROUP BY fact_delta_version,dataset_id,policy_version",
    "external_signals": "SELECT COUNT(*) AS rows, SUM(CASE WHEN is_external_join_ready THEN 1 ELSE 0 END) AS join_ready_rows, SUM(CASE WHEN is_forecast_eligible THEN 1 ELSE 0 END) AS forecast_eligible_rows FROM workspace.medshield_gold.vw_dss_external_signals_candidate"
