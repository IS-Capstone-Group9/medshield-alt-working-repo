    {
      "sql": "SELECT DISTINCT dataset_id, policy_version, publication_status FROM workspace.medshield_gold.sales_restart_fact_candidate VERSION AS OF 20",
      "row_limit": 2
    },
    {
      "sql": "SELECT YEAR(date_delivered) AS year,\n    COUNT(*) AS source_count, MIN(date_delivered) AS first_recorded_date,\n    MAX(date_delivered) AS last_recorded_date,\n    COUNT(DISTINCT date_format(date_delivered, 'yyyy-MM')) AS observed_month_count,\n    COUNT(CASE WHEN is_net_sales_eligible THEN 1 END) AS eligible_count,\n    CAST(SUM(CASE WHEN is_net_sales_eligible THEN net_sales END) AS STRING) AS recorded_net_sales\n    FROM workspace.medshield_gold.sales_restart_fact_candidate VERSION AS OF 20 GROUP BY YEAR(date_delivered) ORDER BY year",
      "row_limit": 200
    },
    {
      "sql": "SELECT date_format(date_delivered, 'yyyy-MM') AS period,\n    COUNT(*) AS source_count, COUNT(CASE WHEN is_net_sales_eligible THEN 1 END) AS eligible_count,\n    CAST(SUM(CASE WHEN is_net_sales_eligible THEN net_sales END) AS STRING) AS recorded_net_sales,\n    COUNT(CASE WHEN is_adjusted_source THEN 1 END) AS adjusted_count\n    FROM workspace.medshield_gold.sales_restart_fact_candidate VERSION AS OF 20 WHERE date_format(date_delivered, 'yyyy-MM') IN ('2024-12', '2025-03', '2025-04', '2025-11')\n    GROUP BY date_format(date_delivered, 'yyyy-MM') ORDER BY period",
